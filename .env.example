# Copie para .env.local e preencha com os dados públicos do projeto Supabase.
# Não coloque service_role key neste arquivo nem no frontend.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_PUBLICA_ANON_OU_PUBLISHABLE
# Para GitHub Pages com repositório chamado catalogo: /catalogo/
VITE_BASE=/catalogo/
